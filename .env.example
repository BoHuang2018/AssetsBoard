# Copy to .env (gitignored) and `chmod 600 .env`. Private but NOT secret values only.
# API keys / tokens / passphrases stay in the macOS Keychain (setup-keychain) — names ending in
# _KEY/_SECRET/_TOKEN/_PASSPHRASE/_PASSWORD are ignored here on purpose.
# Precedence: environment variable > .env > archive/*/config.json, archive/wallets/wallets.json.

# On-chain wallets: WALLET_<wallets.json id, upper-case, non-alnum -> _>_ADDRESS overrides that wallet's address
WALLET_EXAMPLE_ARBITRUM_ADDRESS=0x00000000000000000000000000000000DEADBEEF
WALLET_EXAMPLE_BITTENSOR_ADDRESS=5FakeBittensorAddressDoNotUseReplaceMeXXXXXXX

# ether.fi Cash vault (setting it also enables the account)
ETHERFI_CASH_VAULT=0x00000000000000000000000000000000DEADBEEF

# IBKR Flex query id (the Flex *token* stays in the Keychain); Keychain/env take precedence
IBKR_FLEX_QUERY_ID=0000000

# Not read by the app — listed so the pre-commit guard blocks them from ever being committed
IBKR_ACCOUNT_ID=U00000000
BITGET_TAO_DEPOSIT_ADDRESS=5FakeBitgetDepositAddressReplaceMeXXXXXXXXXXXX
